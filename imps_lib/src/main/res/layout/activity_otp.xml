<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/white"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvOtpTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter OTP to Verify your Number"
        android:textColor="#111827"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="10dp"/>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verification Code sent to "
            android:textColor="@color/greyColor"
            android:textSize="14sp"
            />

        <TextView
            android:id="@+id/tvNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#6B7280"
            android:textSize="14sp"
            />

        <ImageView
            android:id="@+id/ivEdit"
            android:layout_width="@dimen/dp20"
            android:layout_height="@dimen/dp20"
            android:src="@android:drawable/ic_menu_edit"
            android:layout_marginStart="@dimen/dp10"
            />

    </LinearLayout>


    <!-- OTP Input View -->

    <com.mukeshsolanki.OtpView
        android:id="@+id/otp_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp25"
        android:layout_marginBottom="@dimen/dp30"
        app:OtpItemRadius="@dimen/dp5"
        app:OtpItemWidth="@dimen/dp40"
        app:OtpItemHeight="@dimen/dp40"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:inputType="number"
        android:textAllCaps="true"
        android:textColor="@color/colorBlack"
        app:OtpHideLineWhenFilled="false"
        app:OtpItemCount="6"
        app:OtpItemSpacing="6dp"
        app:OtpLineColor="@color/greyColor"
        app:OtpState_filled="true"
        app:OtpViewType="rectangle"
        app:OtpMaskingChar="*"
        />

    <Button
        android:id="@+id/btnSubmitOtp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Submit"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1DA1F2"
        android:padding="12dp"
        android:fontFamily="sans-serif-medium"/>

    <TextView
        android:id="@+id/tvResendOtp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Didn't get the OTP? Resend OTP in 00:30"
        android:textColor="@color/greyColor"
        android:textSize="14sp"
        android:layout_marginTop="16dp"
        android:gravity="center"/>

</LinearLayout>

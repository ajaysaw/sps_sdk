            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp20"
            android:layout_marginRight="@dimen/dp20"
            android:hint="Enter Token"
            android:textSize="@dimen/sp15">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMobileNo"
                style="@style/edittext_style"
                android:inputType="text"
                android:text="eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJodHRwczpcL1wvcW1yLWJldGEtYXBpLnBheXdvcmxkaW5kaWEuY29tIiwiaWF0IjoxNzYxODIxNDUxLCJleHAiOjE3NjE4MjUwNTEsInNlc3Npb25faWQiOiJzZXNzXzY5MDM0MzBiNDY3MGIiLCJ0eG5fcmVmIjoiVFhOOTA0NzIiLCJhZ2VudF9pZCI6MjUsInN0YXRlX2lkIjoiNSIsImJjX2FnZW50X2lkIjoiU0Q0NTk2MDY4NSIsInBhcnR5X2NvZGUiOiI0NTk2MDY4NSJ9.n0QtI5-xUv3-FPcnKxUYwMR-9jHbQEczVM2RABceflc"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/HintUnFocusTextViewStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp20"
            android:layout_marginRight="@dimen/dp20"
            android:hint="Agent Id"
            android:textSize="@dimen/sp15">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAgentId"
                style="@style/edittext_style"
                android:inputType="text"
                android:text="25" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/HintUnFocusTextViewStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp20"
            android:layout_marginRight="@dimen/dp20"
            android:hint="Bc Agent Id"
            android:textSize="@dimen/sp15">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBcAgentId"
                style="@style/edittext_style"
                android:inputType="text"
                android:text="SD45960685" />

        </com.google.android.material.textfield.TextInputLayout>


        <Button
            android:id="@+id/btnDoKyc"
            style="@style/TextViewStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:text="Do eKYC"
            android:textAllCaps="false"
            android:textColor="@color/white_color" />
    </LinearLayout>

</LinearLayout>
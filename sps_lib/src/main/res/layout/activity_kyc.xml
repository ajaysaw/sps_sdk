<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".KycActivity">

    <Toolbar
        android:id="@+id/tbMain"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="@color/colorDarkBlue">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/TextViewStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/complete_E_KYC"
                android:textSize="@dimen/dp17"
                android:textColor="@color/white_color" />
            <TextView
                style="@style/TextViewStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:text="@string/sdk_version"
                android:textSize="@dimen/dp13"
                android:textColor="@color/white_color"
                android:layout_marginRight="@dimen/dp10"/>

        </LinearLayout>

    </Toolbar>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvKyc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:orientation="vertical"
        android:paddingTop="@dimen/dp10">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp15"
            android:layout_marginRight="@dimen/dp15"
            android:orientation="vertical"
            android:theme="@style/Theme.SpsSdk">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tlMobileNo"
                style="@style/CustomTextInputLayoutOutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/customer_mobile"
                android:textSize="@dimen/sp15">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMobileNo"
                    style="@style/edittext_style"
                    android:inputType="number"
                    android:enabled="false"
                    android:maxLength="10" />

            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/ekyc_edit_text_border"
                android:layout_marginTop="@dimen/dp15"
                android:gravity="center_vertical">
                <EditText
                    android:id="@+id/etOtp"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp57"
                    android:layout_weight="1"
                    android:paddingLeft="@dimen/dp15"
                    style="@style/edittext_style"
                    android:maxLength="6"
                    android:hint="@string/enter_otp"
                    android:inputType="number"
                    android:background="@null"
                    android:textColor="@color/black"
                    android:gravity="center_vertical" />
                <TextView
                    android:id="@+id/otpVerifyText"
                    android:layout_width="@dimen/dp80"
                    android:layout_height="@dimen/dp57"
                    android:background="@drawable/edittext_verify_drawable"
                    android:text="@string/verify"
                    android:textSize="@dimen/sp16"
                    android:textColor="@color/white"
                    android:gravity="center" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvOtpSendMessage"
                    style="@style/TextViewStyle12"
                    android:layout_marginTop="@dimen/dp5"
                    android:gravity="start"
                    android:layout_marginHorizontal="@dimen/dp5"
                    android:tag="binding_6"
                    android:text=""
                    android:textColor="@color/greenColor" />

                <TextView
                    android:layout_weight="0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvResendOtp"
                    style="@style/TextViewStyle"
                    android:layout_marginTop="@dimen/dp5"
                    android:gravity="end"
                    android:layout_marginHorizontal="@dimen/dp5"
                    android:tag="binding_6"
                    android:text="@string/resend_otp"
                    android:textColor="@color/colorLightBlue" />


            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextViewStyle"
                android:layout_marginTop="@dimen/dp15"
                android:gravity="start"
                android:text="@string/do_you_have_pan"
                android:textColor="@color/colorLightBlue" />
            <Spinner
                android:id="@+id/confirmationPanSpinner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp55"
                style="@style/CustomSpinnerStyle"
                android:background="@drawable/spinner_background" />
            <TextView
                android:id="@+id/tvCharges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextViewStyle12"
                android:layout_marginTop="@dimen/dp2"
                android:text=""
                android:textColor="@color/greenColor"
                android:visibility="gone"/>
            <LinearLayout
                android:id="@+id/panLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/ekyc_edit_text_border"
                android:layout_marginTop="@dimen/dp15"
                android:gravity="center_vertical">
                <EditText
                    android:id="@+id/etPanNo"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp57"
                    android:layout_weight="1"
                    android:paddingLeft="@dimen/dp15"
                    style="@style/edittext_style"
                    android:hint="@string/pan_num"
                    android:maxLength="10"
                    android:textAllCaps="true"
                    android:inputType="textCapCharacters"
                    android:background="@null"
                    android:textColor="@color/black"
                    android:gravity="center_vertical" />
                <TextView
                    android:id="@+id/panVerifyText"
                    android:layout_width="@dimen/dp80"
                    android:layout_height="@dimen/dp57"
                    android:background="@drawable/button_disbled"
                    android:text="@string/verify"
                    android:textSize="@dimen/sp16"
                    android:textColor="@color/white"
                    android:gravity="center" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/noPanLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/TextViewStyle"
                    android:layout_marginTop="@dimen/dp15"
                    android:gravity="start"
                    android:text="@string/do_you_have_pan_applied"
                    android:textColor="@color/colorLightBlue" />
                <Spinner
                    android:id="@+id/confirmationPanAppliedSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp55"
                    style="@style/CustomSpinnerStyle"
                    android:background="@drawable/spinner_background" />
                <LinearLayout
                    android:id="@+id/panAcknowledgementLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tlPanAcknowledgementNumber"
                        style="@style/CustomTextInputLayoutOutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp15"
                        android:hint="@string/pan_acknowledgement_number"
                        android:textSize="@dimen/sp15">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPanAcknowledgementNumber"
                            style="@style/edittext_style"
                            android:inputType="textCapCharacters"
                            android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"/>

                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tlPanAcknowledgementDate"
                        style="@style/CustomTextInputLayoutOutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp15"
                        android:hint="@string/pan_acknowledgement_date"
                        android:textSize="@dimen/sp15">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPanAcknowledgementDate"
                            style="@style/edittext_style"
                            android:inputType="none"
                            android:focusable="false"
                            android:maxLength="10"/>

                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tlFatherName"
                    style="@style/CustomTextInputLayoutOutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp15"
                    android:hint="@string/father_name"
                    android:textSize="@dimen/sp15">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFatherName"
                        style="@style/edittext_style"
                        android:inputType="text"
                        android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz "
                        android:maxLength="150" />

                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tlAgriculturalIncome"
                    style="@style/CustomTextInputLayoutOutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp15"
                    android:hint="@string/agricultural_income"
                    android:textSize="@dimen/sp15">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAgriculturalIncome"
                        style="@style/edittext_style"
                        android:inputType="number"
                        android:maxLength="10" />

                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tlOtherAgriculturalIncome"
                    style="@style/CustomTextInputLayoutOutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp15"
                    android:hint="@string/other_then_agricultural_income"
                    android:textSize="@dimen/sp15">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOtherAgriculturalIncome"
                        style="@style/edittext_style"
                        android:inputType="number"
                        android:maxLength="10" />

                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tlAadhaarNo"
                style="@style/CustomTextInputLayoutOutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp15"
                android:hint="@string/aadhaar_num"
                android:textSize="@dimen/sp15">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAadhaarNo"
                    style="@style/edittext_style"
                    android:inputType="number"
                    android:maxLength="16" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextViewStyle"
                android:layout_marginTop="@dimen/dp15"
                android:gravity="start"
                android:text="@string/authentication"
                android:textColor="@color/colorLightBlue" />

            <Spinner
                android:id="@+id/authentication"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp55"
                style="@style/CustomSpinnerStyle"
                android:background="@drawable/spinner_background" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextViewStyle"
                android:layout_marginTop="@dimen/dp15"
                android:gravity="start"
                android:text="@string/devices"
                android:textColor="@color/colorLightBlue" />

            <Spinner
                android:id="@+id/spnDevices"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp55"
                style="@style/CustomSpinnerStyle"
                android:background="@drawable/spinner_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextViewStyle"
                android:layout_marginTop="@dimen/dp15"
                android:gravity="start"
                android:tag="binding_6"
                android:text="@string/consent_language"
                android:textColor="@color/colorLightBlue" />

            <Spinner
                android:id="@+id/spnConsentLanguage"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp55"
                style="@style/CustomSpinnerStyle"
                android:background="@drawable/spinner_background" />

            <TextView
                android:id="@+id/btnPlayStop"
                android:layout_width="@dimen/dp110"
                android:layout_height="@dimen/dp30"
                android:layout_marginTop="@dimen/dp10"
                android:layout_marginLeft="@dimen/dp3"
                style="@style/TextViewStyle12"
                android:gravity="center_vertical"
                android:background="@drawable/audio_circle_button"
                android:drawableStart="@drawable/play_arrow"
                android:text="@string/play_audio"
                android:textColor="@color/black"
                android:padding="@dimen/dp7"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/llConsent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:layout_marginBottom="@dimen/dp20"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbConsent"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:buttonTint="@color/blueColor"/>

                <TextView
                    android:id="@+id/tvConsentContent"
                    style="@style/TextViewStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp20"
                    android:textSize="@dimen/dp12"
                    android:textColor="@color/greyColor"
                    android:text="" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvSubmit"
                style="@style/TextViewStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_button"
                android:drawableRight="@drawable/arrow_forward"
                android:gravity="center"
                android:padding="@dimen/dp5"
                android:text="Complete your KYC"
                android:textColor="@color/white_color" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/dp10"
            android:layout_marginBottom="@dimen/dp20">
            <TextView
                android:id="@+id/tvPoweredBY"
                style="@style/TextViewStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/dp12"
                android:text="© Powered by"
                android:textColor="@color/greyColor"/>
            <ImageView
                android:layout_width="@dimen/dp50"
                android:layout_height="@dimen/dp17"
                android:src="@drawable/pw_money_logo"
                android:orientation="vertical"/>
        </LinearLayout>

        </LinearLayout>


    </androidx.core.widget.NestedScrollView>

</LinearLayout>
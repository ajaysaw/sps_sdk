<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".mr.TransferToBankAccountFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollViewAddBeneficiary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:orientation="vertical"
        android:paddingTop="@dimen/dp10">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp10"
            android:layout_marginTop="@dimen/dp10"
            android:layout_marginRight="@dimen/dp10"
            android:orientation="vertical"
            android:theme="@style/Theme.SpsSdk">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp3"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/dp10"
                app:cardElevation="@dimen/dp4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dp8">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextViewStyleBold13"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:layout_marginStart="@dimen/dp3"
                            android:layout_weight="1"
                            android:text="@string/transfer_beneficiary_name"
                            android:textColor="@color/blueColor" />

                        <TextView
                            android:id="@+id/tvTransferBeneficiaryName"
                            style="@style/RegularTextViewStyle12"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/dp3"
                            android:gravity="end"
                            android:text="Ajay Kumar"
                            android:textColor="@color/blueColor" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextViewStyleBold13"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:layout_marginStart="@dimen/dp3"
                            android:layout_weight="1"
                            android:text="@string/transfer_account_number"
                            android:textColor="@color/blueColor" />
                         <LinearLayout
                             android:layout_width="0dp"
                             android:layout_weight="1"
                             android:layout_height="wrap_content"
                             android:gravity="end"
                             android:layout_marginEnd="@dimen/dp3"
                             android:orientation="horizontal">
                             <ImageView
                                 android:id="@+id/myImageView"
                                 android:layout_width="@dimen/dp15"
                                 android:layout_height="@dimen/dp15"
                                 android:layout_gravity="center"
                                 android:src="@drawable/verify"
                                 android:adjustViewBounds="true"
                                 android:layout_marginEnd="@dimen/dp2"
                                 android:scaleType="centerCrop"
                                 />
                             <TextView
                                 android:id="@+id/tvTransferAccountNumber"
                                 style="@style/RegularTextViewStyle12"
                                 android:layout_width="wrap_content"
                                 android:layout_height="wrap_content"
                                 android:text="965874587459"
                                 android:textColor="@color/blueColor" />
                         </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextViewStyleBold13"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:layout_marginStart="@dimen/dp3"
                            android:layout_weight="1"
                            android:text="@string/transfer_bank"
                            android:textColor="@color/blueColor" />

                        <TextView
                            android:id="@+id/tvTransferBank"
                            style="@style/RegularTextViewStyle12"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/dp3"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="Mahindra Bank"
                            android:textColor="@color/blueColor" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextViewStyleBold13"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:layout_marginStart="@dimen/dp3"
                            android:layout_marginBottom="@dimen/dp3"
                            android:layout_weight="1"
                            android:text="@string/transfer_ifsc_code"
                            android:textColor="@color/blueColor" />

                        <TextView
                            android:id="@+id/tvTransferIfscCode"
                            style="@style/RegularTextViewStyle12"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/dp3"
                            android:layout_marginBottom="@dimen/dp3"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="KKBK74587458"
                            android:textColor="@color/blueColor" />

                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnVerify"
                            style="@style/RegularTextViewStyle12"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_gravity="start"
                            android:gravity="center"
                            android:background="@drawable/button_drawable_light_blue"
                            android:paddingHorizontal="@dimen/dp15"
                            android:paddingTop="@dimen/dp5"
                            android:paddingBottom="@dimen/dp5"
                            android:text="Verify"
                            android:textColor="@color/white" />

                        <TextView
                            android:id="@+id/tvProceedToPay"
                            style="@style/RegularTextViewStyle12"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_gravity="end"
                            android:gravity="center"
                            android:background="@drawable/button_drawable_light_blue"
                            android:drawableEnd="@drawable/arrow_forward_24"
                            android:drawableTint="@color/white"
                            android:paddingHorizontal="@dimen/dp15"
                            android:paddingTop="@dimen/dp5"
                            android:paddingBottom="@dimen/dp5"
                            android:text="Transfer"
                            android:textColor="@color/white" />
                    </RelativeLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>